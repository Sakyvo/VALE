{
  "name": "mc-texture-pack-site",
  "version": "1.0.0",
  "scripts": {
    "build": "node scripts/extract-textures.js && node scripts/generate-index.js && node scripts/build.js",
    "extract": "node scripts/extract-textures.js",
    "index": "node scripts/generate-index.js",
    "test": "node --test \"tests/*.test.js\"",
    "packs:scan-content": "node scripts/scan-pack-content.js",
    "packs:detect-special": "node scripts/detect-special-packs.js",
    "packs:execute-normalization": "node scripts/execute-reviewed-normalization.js",
    "packs:finalize-replacements": "node scripts/finalize-pack-replacements.js",
    "fix:preview-alpha": "node scripts/fix-thumbnail-preview-alpha.js",
    "sbi:data": "node scripts/generate-sbi-data.js",
    "overlay:detect": "node scripts/detect-overlay.js"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "adm-zip": "^0.5.10",
    "pngjs": "^7.0.0",
    "sharp": "^0.33.0"
  }
}
